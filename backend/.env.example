# ==============================================================
# SkillNexus AI - Backend Environment Configuration Example
# ==============================================================

# Server Port & Environment
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# JWT Secret Key for token signing (HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_here

# Database: MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillnexus?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Job Recommendations: Adzuna API (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Coding Interview: Self-Hosted Judge0 CE (Optional)
JUDGE0_API_URL=http://localhost:2358

# GitHub Personal Access Token (Optional - increases rate limit from 60 to 5000 requests/hr)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub OAuth Application (Optional - for "Connect with GitHub" private repo authorization)
# Register your OAuth App at: https://github.com/settings/developers
# - Application name: SkillNexus AI
# - Homepage URL: http://localhost:5173 (or your production frontend URL)
# - Authorization callback URL: http://localhost:3000/api/github/oauth/callback (or your production backend URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/oauth/callback

# Razorpay Payment Integration (Optional / Test mode)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# OpenRouter AI Integration (Optional / Secondary AI engine)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
