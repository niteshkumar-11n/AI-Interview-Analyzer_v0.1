# ==============================================================
# SkillNexus AI - Backend Environment Configuration Example
# ==============================================================

# Server Port & Environment
PORT=3000
NODE_ENV=development

# JWT Secret Key for token signing (HMAC-SHA256)
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application Origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Database: MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillnexus?retryWrites=true&w=majority
MONGODB_URI=

# Google Gemini API Key
# For AI interview analysis, coding assistance, and smart recommendations
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=